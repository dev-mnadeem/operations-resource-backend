# Local/Docker: copy to .env and fill in. Production (Heroku): use Heroku Config Vars;
# DATABASE_URL is set automatically by the Heroku Postgres addon.

DEBUG=True
SECRET_KEY=

ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=arcadian_erp
DB_USER=erp_user
DB_PASSWORD=supersecretpassword
# Use DB_HOST=db when running with docker-compose (service name). Use 127.0.0.1 for local dev.
DB_HOST=127.0.0.1
DB_PORT=5432

# IMAP Settings for Sales Email Polling
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

