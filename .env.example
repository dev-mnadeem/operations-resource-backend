# Copy to .env and fill in. On Heroku use Config Vars instead; the Postgres
# add-on sets DATABASE_URL, which takes precedence over the DB_* values.

DEBUG=True
# Generate one with: python scripts/generate_secret_key.py
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=arcadian_erp
DB_USER=erp_user
DB_PASSWORD=change-me
# Only used outside Docker; the compose files point Django at their `db` service.
DB_HOST=127.0.0.1
DB_PORT=5432

# Host port for docker-compose.yml (gunicorn).
WEB_PORT=8500

# Passwords for the demo accounts that setup_dev / seed_data create.
# Leave blank to have a random one generated and printed.
DEV_ADMIN_PASSWORD=
DEV_SEED_PASSWORD=

# Sales email import (Celery beat polls every 5 minutes). Leave IMAP_HOST
# blank to switch it off.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Media uploads go to Cloudinary only when all three are set; otherwise
# they are stored on local disk under media/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notification email. The console backend prints messages to the log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

LOG_LEVEL=INFO
